{
  "info": {
    "name": "Alumni Tracking System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/api/health" } },
    { "name": "List users", "request": { "method": "GET", "url": "{{baseUrl}}/api/users" } },
    { "name": "Get user", "request": { "method": "GET", "url": "{{baseUrl}}/api/users/1" } },
    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ayşe Yılmaz\",\n  \"email\": \"ayse@example.com\",\n  \"graduation_year\": 2022,\n  \"department\": \"Management Information Systems\"\n}"
        }
      }
    },
    {
      "name": "Replace user (PUT)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/users/1",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ayşe Yılmaz\",\n  \"email\": \"ayse.yilmaz@example.com\",\n  \"graduation_year\": 2022,\n  \"department\": \"Management Information Systems\"\n}"
        }
      }
    },
    {
      "name": "Update user (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/users/1",
        "body": { "mode": "raw", "raw": "{\n  \"department\": \"Economics\"\n}" }
      }
    },
    { "name": "Delete user", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/users/1" } },
    { "name": "List announcements", "request": { "method": "GET", "url": "{{baseUrl}}/api/announcements" } },
    { "name": "Get announcement", "request": { "method": "GET", "url": "{{baseUrl}}/api/announcements/1" } },
    {
      "name": "Create announcement",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/announcements",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Alumni Meetup 2026\",\n  \"author\": \"IU MIS\",\n  \"category\": \"Event\",\n  \"content\": \"Annual gathering at the campus.\"\n}"
        }
      }
    },
    { "name": "Delete announcement", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/announcements/1" } },
    { "name": "List job postings", "request": { "method": "GET", "url": "{{baseUrl}}/api/jobs" } },
    { "name": "Get job posting", "request": { "method": "GET", "url": "{{baseUrl}}/api/jobs/1" } },
    {
      "name": "Create job posting",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/jobs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Junior Software Engineer\",\n  \"company\": \"Tech Solutions Inc.\",\n  \"city\": \"Istanbul\",\n  \"description\": \"Full stack developer needed.\"\n}"
        }
      }
    },
    {
      "name": "Create job for user (POST /api/users/1/jobs)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/users/1/jobs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"MIS IT Specialist\",\n  \"company\": \"Global Logistics\",\n  \"city\": \"Izmir\"\n}"
        }
      }
    },
    { "name": "List jobs for user (GET /api/users/1/jobs)", "request": { "method": "GET", "url": "{{baseUrl}}/api/users/1/jobs" } },
    { "name": "Delete job posting", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/jobs/1" } },
    {
      "name": "Invalid: Missing Title (Expect 400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/jobs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"company\": \"Tech Solutions Inc.\"\n}"
        }
      }
    },
    {
      "name": "Invalid: Title Exceeds 120 Chars (Expect 400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/jobs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"This is an extremely long job title that definitely exceeds the maximum permitted limit of one hundred and twenty characters set in our data design documentation rules.\",\n  \"company\": \"Tech Solutions Inc.\"\n}"
        }
      }
    },
    {
      "name": "Invalid: Missing Company (Expect 400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/jobs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Frontend Specialist\"\n}"
        }
      }
    },
    {
      "name": "Invalid: 404 Guardian - Unknown Route (Expect 404 with reason)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/unknown-endpoint"
      }
    },
    {
      "name": "Invalid: 404 Guardian - Non-existent Job ID (Expect 404 with reason)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/jobs/999999"
      }
    },
    {
      "name": "Invalid: 5xx Guardian - Trigger Test Error (Expect 500 & logs/error.logs)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/test-error"
      }
    }
  ]
}
