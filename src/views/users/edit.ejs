<%- include('../partials/header', { active: 'users', title: 'Edit ' + (user.name || '') }) %>
<main class="page narrow">
  <div class="eyebrow">Graduate #<%= user.id %></div>
  <h1>Edit details</h1>
  <% if (errors.length) { %>
    <div class="problem"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
  <% } %>
  <div class="formbox">
    <%- include('../partials/user-form', { user, action: `/users/${user.id}/edit`, submit: 'Save changes' }) %>
  </div>
  <p><a href="/users">&larr; Back to alumni</a></p>
</main>
<%- include('../partials/footer') %>
